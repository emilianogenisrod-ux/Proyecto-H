# Copie este archivo a .env y llénelo en su computadora.
# El archivo .env no se sube a GitHub.

DATABASE_URL=sqlite:///./data/hospital.db
APP_TITLE=Gestor de Citas Hospitalarias
SESSION_SECRET=change-me-in-production

# Contraseñas solo locales, en JSON. Déjelo vacío si no va a entrar al panel.
# USER_PASSWORDS_JSON={"correo@ejemplo.com":"su-clave-local"}
USER_PASSWORDS_JSON=

# Base de datos de producción: se configura en el servidor, no aquí.
# DATABASE_URL=

# MinIO: se configura en el servidor. En local puede quedar apagado.
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=hospital
MINIO_SECURE=true
MINIO_PUBLIC_BASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
